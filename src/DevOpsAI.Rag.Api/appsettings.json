{
  "Urls": "http://127.0.0.1:5082",
  "RunbookDocuments": {
    "MaxDocumentSizeBytes": 1048576
  },
  "ConnectionStrings": {
    "RagDatabase": "Data Source=runbook-rag.db"
  },
  "RunbookChunking": {
    "MaximumChunkCharacters": 1000,
    "OverlapCharacters": 150
  },
  "RunbookRetrieval": {
    "MinimumRelevanceScore": 0.7,
    "TopK": 5
  },
  "Ollama": {
    "Endpoint": "http://127.0.0.1:11434",
    "RequestTimeout": "00:01:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
